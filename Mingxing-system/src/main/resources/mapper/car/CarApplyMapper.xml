<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mingxing.car.mapper.CarApplyMapper">

    <resultMap type="CarApply" id="CarApplyResult">
        <id     property="applyId"         column="apply_id"         />
        <result property="applyNo"         column="apply_no"         />
        <result property="applicantName"   column="applicant_name"   />
        <result property="deptName"        column="dept_name"        />
        <result property="applyDate"       column="apply_date"       />
        <result property="startPlace"      column="start_place"      />
        <result property="endPlace"        column="end_place"        />
        <result property="departureTime"   column="departure_time"   />
        <result property="returnTime"      column="return_time"      />
        <result property="returnTimeTbd"   column="return_time_tbd"  />
        <result property="tripType"        column="trip_type"        />
        <result property="useType"         column="use_type"         />
        <result property="purposeType"     column="purpose_type"     />
        <result property="driverAccompany" column="driver_accompany" />
        <result property="otherPurpose"    column="other_purpose"    />
        <result property="contactPhone"    column="contact_phone"    />
        <result property="purpose"         column="purpose"          />
        <result property="vehicleId"       column="vehicle_id"       />
        <result property="plateNumber"     column="plate_number"     />
        <result property="driverId"        column="driver_id"        />
        <result property="driverName"      column="driver_name"      />
        <result property="vehicleType"     column="vehicle_type"     />
        <result property="externalPlateNumber" column="external_plate_number" />
        <result property="externalDriverPhone" column="external_driver_phone" />
        <result property="status"          column="status"           />
        <result property="auditRemark"     column="audit_remark"     />
        <result property="auditBy"         column="audit_by"         />
        <result property="auditTime"       column="audit_time"       />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
        <result property="delFlag"         column="del_flag"         />
        <result property="remark"          column="remark"           />
        <result property="hiddenBy"        column="hidden_by"        />
    </resultMap>

    <sql id="selectCarApplyVo">
        select a.apply_id, a.apply_no, a.applicant_name, a.dept_name, a.apply_date,
               a.start_place, a.end_place, a.departure_time, a.return_time,
               a.return_time_tbd, a.trip_type, a.use_type, a.purpose_type,
               a.driver_accompany, a.other_purpose, a.contact_phone, a.purpose,
               a.vehicle_id, v.plate_number, a.driver_id, d.driver_name,
               a.vehicle_type, a.external_plate_number, a.external_driver_phone,
               a.status, a.audit_remark, a.audit_by, a.audit_time,
               a.create_by, a.create_time, a.update_by, a.update_time, a.del_flag, a.remark,
               a.hidden_by, a.is_urgent
        from car_apply a
        left join car_vehicle v on a.vehicle_id = v.vehicle_id
        left join car_driver d on a.driver_id = d.driver_id
    </sql>

    <select id="selectCarApplyList" parameterType="CarApply" resultMap="CarApplyResult">
        <include refid="selectCarApplyVo"/>
        <where>
            a.del_flag = '0'
            <if test="applicantName != null and applicantName != ''">
                AND a.applicant_name like concat('%', #{applicantName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND a.status = #{status}
            </if>
            <if test="applyNo != null and applyNo != ''">
                AND a.apply_no like concat('%', #{applyNo}, '%')
            </if>
            <if test="useType != null and useType != ''">
                AND a.use_type = #{useType}
            </if>
            <if test="vehicleId != null">
                AND a.vehicle_id = #{vehicleId}
            </if>
            <if test="driverId != null">
                AND a.driver_id = #{driverId}
            </if>
            <if test="createBy != null and createBy != ''">
                AND a.create_by = #{createBy}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and date_format(a.create_time,'%Y%m%d') >= date_format(#{params.beginTime},'%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and date_format(a.create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
            </if>
            <if test="hiddenBy != null">
                AND (a.hidden_by is null or a.hidden_by != #{hiddenBy})
            </if>
            <if test="isUrgent != null and isUrgent != ''">
                AND a.is_urgent = #{isUrgent}
            </if>
        </where>
        order by a.create_time desc
    </select>

    <update id="updateApplyHidden">
        update car_apply
        set hidden_by = #{hiddenBy}
        where apply_id = #{applyId}
    </update>

    <select id="selectCarApplyById" parameterType="Long" resultMap="CarApplyResult">
        <include refid="selectCarApplyVo"/>
        where a.apply_id = #{applyId}
    </select>

    <insert id="insertCarApply" parameterType="CarApply" useGeneratedKeys="true" keyProperty="applyId">
        insert into car_apply (
            <if test="applyNo != null and applyNo != ''">apply_no,</if>
            <if test="applicantName != null and applicantName != ''">applicant_name,</if>
            <if test="deptName != null and deptName != ''">dept_name,</if>
            <if test="applyDate != null">apply_date,</if>
            <if test="startPlace != null and startPlace != ''">start_place,</if>
            <if test="endPlace != null and endPlace != ''">end_place,</if>
            <if test="departureTime != null">departure_time,</if>
            <if test="returnTime != null">return_time,</if>
            <if test="returnTimeTbd != null and returnTimeTbd != ''">return_time_tbd,</if>
            <if test="tripType != null and tripType != ''">trip_type,</if>
            <if test="useType != null and useType != ''">use_type,</if>
            <if test="purposeType != null and purposeType != ''">purpose_type,</if>
            <if test="driverAccompany != null and driverAccompany != ''">driver_accompany,</if>
            <if test="otherPurpose != null and otherPurpose != ''">other_purpose,</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone,</if>
            <if test="purpose != null and purpose != ''">purpose,</if>
            <if test="vehicleId != null">vehicle_id,</if>
            <if test="driverId != null">driver_id,</if>
            <if test="vehicleType != null and vehicleType != ''">vehicle_type,</if>
            <if test="externalPlateNumber != null and externalPlateNumber != ''">external_plate_number,</if>
            <if test="externalDriverPhone != null and externalDriverPhone != ''">external_driver_phone,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="isUrgent != null and isUrgent != ''">is_urgent,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        ) values (
            <if test="applyNo != null and applyNo != ''">#{applyNo},</if>
            <if test="applicantName != null and applicantName != ''">#{applicantName},</if>
            <if test="deptName != null and deptName != ''">#{deptName},</if>
            <if test="applyDate != null">#{applyDate},</if>
            <if test="startPlace != null and startPlace != ''">#{startPlace},</if>
            <if test="endPlace != null and endPlace != ''">#{endPlace},</if>
            <if test="departureTime != null">#{departureTime},</if>
            <if test="returnTime != null">#{returnTime},</if>
            <if test="returnTimeTbd != null and returnTimeTbd != ''">#{returnTimeTbd},</if>
            <if test="tripType != null and tripType != ''">#{tripType},</if>
            <if test="useType != null and useType != ''">#{useType},</if>
            <if test="purposeType != null and purposeType != ''">#{purposeType},</if>
            <if test="driverAccompany != null and driverAccompany != ''">#{driverAccompany},</if>
            <if test="otherPurpose != null and otherPurpose != ''">#{otherPurpose},</if>
            <if test="contactPhone != null and contactPhone != ''">#{contactPhone},</if>
            <if test="purpose != null and purpose != ''">#{purpose},</if>
            <if test="vehicleId != null">#{vehicleId},</if>
            <if test="driverId != null">#{driverId},</if>
            <if test="vehicleType != null and vehicleType != ''">#{vehicleType},</if>
            <if test="externalPlateNumber != null and externalPlateNumber != ''">#{externalPlateNumber},</if>
            <if test="externalDriverPhone != null and externalDriverPhone != ''">#{externalDriverPhone},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="isUrgent != null and isUrgent != ''">#{isUrgent},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateCarApply" parameterType="CarApply">
        update car_apply
        <set>
            <if test="applyNo != null">apply_no = #{applyNo},</if>
            <if test="applicantName != null and applicantName != ''">applicant_name = #{applicantName},</if>
            <if test="deptName != null">dept_name = #{deptName},</if>
            <if test="applyDate != null">apply_date = #{applyDate},</if>
            <if test="startPlace != null">start_place = #{startPlace},</if>
            <if test="endPlace != null">end_place = #{endPlace},</if>
            <if test="departureTime != null">departure_time = #{departureTime},</if>
            <if test="returnTime != null">return_time = #{returnTime},</if>
            <if test="returnTimeTbd != null">return_time_tbd = #{returnTimeTbd},</if>
            <if test="tripType != null">trip_type = #{tripType},</if>
            <if test="useType != null">use_type = #{useType},</if>
            <if test="purposeType != null">purpose_type = #{purposeType},</if>
            <if test="driverAccompany != null">driver_accompany = #{driverAccompany},</if>
            <if test="otherPurpose != null">other_purpose = #{otherPurpose},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="purpose != null">purpose = #{purpose},</if>
            <if test="vehicleId != null">vehicle_id = #{vehicleId},</if>
            <if test="driverId != null">driver_id = #{driverId},</if>
            <if test="vehicleType != null">vehicle_type = #{vehicleType},</if>
            <if test="externalPlateNumber != null">external_plate_number = #{externalPlateNumber},</if>
            <if test="externalDriverPhone != null">external_driver_phone = #{externalDriverPhone},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="isUrgent != null">is_urgent = #{isUrgent},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            <if test="auditBy != null and auditBy != ''">audit_by = #{auditBy},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where apply_id = #{applyId}
    </update>

    <delete id="deleteCarApplyById" parameterType="Long">
        update car_apply set del_flag = '2' where apply_id = #{applyId}
    </delete>

    <delete id="deleteCarApplyByIds" parameterType="Long">
        update car_apply set del_flag = '2' where apply_id in
        <foreach item="applyId" collection="array" open="(" separator="," close=")">
            #{applyId}
        </foreach>
    </delete>

</mapper>