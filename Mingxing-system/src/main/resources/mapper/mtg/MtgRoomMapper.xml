<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mingxing.mtg.mapper.MtgRoomMapper">

    <resultMap type="MtgRoom" id="MtgRoomResult">
        <id     property="roomId"            column="room_id"            />
        <result property="roomName"          column="room_name"          />
        <result property="roomNameEn"        column="room_name_en"       />
        <result property="deptId"            column="dept_id"            />
        <result property="deptName"          column="dept_name"          />
        <result property="floor"             column="floor"              />
        <result property="floorEn"           column="floor_en"           />
        <result property="location"          column="location"           />
        <result property="capacity"          column="capacity"           />
        <result property="imageUrl"          column="image_url"          />
        <result property="openTime"          column="open_time"          />
        <result property="closeTime"         column="close_time"         />
        <result property="bufferTime"        column="buffer_time"        />
        <result property="status"            column="status"             />
        <result property="visibilityScope"   column="visibility_scope"   />
        <result property="needApproval"      column="need_approval"      />
        <result property="sort"              column="sort"               />
        <result property="delFlag"           column="del_flag"           />
        <result property="createBy"          column="create_by"          />
        <result property="createTime"        column="create_time"        />
        <result property="updateBy"          column="update_by"          />
        <result property="updateTime"        column="update_time"        />
        <result property="remark"            column="remark"             />
    </resultMap>

    <sql id="selectRoomVo">
        select r.room_id, r.room_name, r.room_name_en, r.dept_id, d.dept_name, r.floor, r.floor_en, r.location,
               r.capacity, r.image_url, r.open_time, r.close_time, r.buffer_time,
               r.status, r.visibility_scope, r.need_approval, r.sort, r.del_flag,
               r.create_by, r.create_time, r.update_by, r.update_time, r.remark
        from mtg_room r
        left join sys_dept d on r.dept_id = d.dept_id
    </sql>

    <select id="selectRoomList" parameterType="MtgRoom" resultMap="MtgRoomResult">
        <include refid="selectRoomVo"/>
        <where>
            r.del_flag = '0'
            <if test="roomName != null and roomName != ''">
                AND r.room_name like concat('%', #{roomName}, '%')
            </if>
            <if test="deptId != null">
                AND r.dept_id = #{deptId}
            </if>
            <if test="floor != null and floor != ''">
                AND r.floor = #{floor}
            </if>
            <if test="status != null and status != ''">
                AND r.status = #{status}
            </if>
            <if test="visibilityScope != null and visibilityScope != ''">
                AND r.visibility_scope = #{visibilityScope}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and date_format(r.create_time,'%Y%m%d') >= date_format(#{params.beginTime},'%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and date_format(r.create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
            </if>
        </where>
        order by r.sort asc, r.room_id asc
    </select>

    <select id="selectRoomById" parameterType="Long" resultMap="MtgRoomResult">
        <include refid="selectRoomVo"/>
        where r.room_id = #{roomId} and r.del_flag = '0'
    </select>

    <select id="selectRoomByIdForUpdate" parameterType="Long" resultMap="MtgRoomResult">
        <include refid="selectRoomVo"/>
        where r.room_id = #{roomId} and r.del_flag = '0' for update
    </select>

    <select id="selectRoomWithDevices" parameterType="Long" resultMap="MtgRoomResult">
        <include refid="selectRoomVo"/>
        where r.room_id = #{roomId} and r.del_flag = '0'
    </select>

    <select id="selectRoomByName" parameterType="MtgRoom" resultMap="MtgRoomResult">
        <include refid="selectRoomVo"/>
        where r.room_name = #{roomName} and r.del_flag = '0'
        <if test="roomId != null">
            and r.room_id != #{roomId}
        </if>
        limit 1
    </select>

    <insert id="insertRoom" parameterType="MtgRoom" useGeneratedKeys="true" keyProperty="roomId">
        insert into mtg_room (
            <if test="roomName != null and roomName != ''">room_name,</if>
            <if test="roomNameEn != null and roomNameEn != ''">room_name_en,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="floor != null and floor != ''">floor,</if>
            <if test="floorEn != null and floorEn != ''">floor_en,</if>
            <if test="location != null and location != ''">location,</if>
            <if test="capacity != null">capacity,</if>
            <if test="imageUrl != null and imageUrl != ''">image_url,</if>
            <if test="openTime != null and openTime != ''">open_time,</if>
            <if test="closeTime != null and closeTime != ''">close_time,</if>
            <if test="bufferTime != null">buffer_time,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="visibilityScope != null and visibilityScope != ''">visibility_scope,</if>
            <if test="needApproval != null">need_approval,</if>
            <if test="sort != null">sort,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        ) values (
            <if test="roomName != null and roomName != ''">#{roomName},</if>
            <if test="roomNameEn != null and roomNameEn != ''">#{roomNameEn},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="floor != null and floor != ''">#{floor},</if>
            <if test="floorEn != null and floorEn != ''">#{floorEn},</if>
            <if test="location != null and location != ''">#{location},</if>
            <if test="capacity != null">#{capacity},</if>
            <if test="imageUrl != null and imageUrl != ''">#{imageUrl},</if>
            <if test="openTime != null and openTime != ''">#{openTime},</if>
            <if test="closeTime != null and closeTime != ''">#{closeTime},</if>
            <if test="bufferTime != null">#{bufferTime},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="visibilityScope != null and visibilityScope != ''">#{visibilityScope},</if>
            <if test="needApproval != null">#{needApproval},</if>
            <if test="sort != null">#{sort},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateRoom" parameterType="MtgRoom">
        update mtg_room
        <set>
            <if test="roomName != null and roomName != ''">room_name = #{roomName},</if>
            <if test="roomNameEn != null">room_name_en = #{roomNameEn},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="floor != null and floor != ''">floor = #{floor},</if>
            <if test="floorEn != null">floor_en = #{floorEn},</if>
            <if test="location != null and location != ''">location = #{location},</if>
            <if test="capacity != null">capacity = #{capacity},</if>
            <if test="imageUrl != null and imageUrl != ''">image_url = #{imageUrl},</if>
            <if test="openTime != null and openTime != ''">open_time = #{openTime},</if>
            <if test="closeTime != null and closeTime != ''">close_time = #{closeTime},</if>
            <if test="bufferTime != null">buffer_time = #{bufferTime},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="visibilityScope != null and visibilityScope != ''">visibility_scope = #{visibilityScope},</if>
            <if test="needApproval != null">need_approval = #{needApproval},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where room_id = #{roomId}
    </update>

    <delete id="deleteRoomById" parameterType="Long">
        update mtg_room set del_flag = '2' where room_id = #{roomId}
    </delete>

    <delete id="deleteRoomByIds" parameterType="Long">
        update mtg_room set del_flag = '2' where room_id in
        <foreach item="roomId" collection="array" open="(" separator="," close=")">
            #{roomId}
        </foreach>
    </delete>

    <select id="selectDeviceIdsByRoomId" parameterType="Long" resultType="Long">
        select device_id from mtg_room_device where room_id = #{roomId}
    </select>

</mapper>