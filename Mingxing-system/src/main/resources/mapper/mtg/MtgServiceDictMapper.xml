<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mingxing.mtg.mapper.MtgServiceDictMapper">

    <resultMap type="MtgServiceDict" id="MtgServiceDictResult">
        <id     property="serviceId"      column="service_id"      />
        <result property="serviceName"    column="service_name"    />
        <result property="serviceNameEn"  column="service_name_en" />
        <result property="icon"           column="icon"            />
        <result property="sort"           column="sort"            />
        <result property="status"         column="status"          />
        <result property="emailNotify"    column="email_notify"    />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectServiceDictVo">
        select service_id, service_name, service_name_en, icon, sort, status, email_notify, create_by, create_time, update_by, update_time, remark
        from mtg_service_dict
    </sql>

    <select id="selectServiceDictList" parameterType="MtgServiceDict" resultMap="MtgServiceDictResult">
        <include refid="selectServiceDictVo"/>
        <where>
            <if test="serviceName != null and serviceName != ''">
                AND service_name like concat('%', #{serviceName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and date_format(create_time,'%Y%m%d') >= date_format(#{params.beginTime},'%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and date_format(create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
            </if>
        </where>
        order by sort asc, service_id asc
    </select>

    <select id="selectServiceDictById" parameterType="Long" resultMap="MtgServiceDictResult">
        <include refid="selectServiceDictVo"/>
        where service_id = #{serviceId}
    </select>

    <select id="selectServiceDictByName" parameterType="String" resultMap="MtgServiceDictResult">
        <include refid="selectServiceDictVo"/>
        where service_name = #{serviceName} limit 1
    </select>

    <insert id="insertServiceDict" parameterType="MtgServiceDict">
        insert into mtg_service_dict (
            <if test="serviceName != null and serviceName != ''">service_name,</if>
            <if test="serviceNameEn != null and serviceNameEn != ''">service_name_en,</if>
            <if test="icon != null and icon != ''">icon,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="emailNotify != null and emailNotify != ''">email_notify,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        ) values (
            <if test="serviceName != null and serviceName != ''">#{serviceName},</if>
            <if test="serviceNameEn != null and serviceNameEn != ''">#{serviceNameEn},</if>
            <if test="icon != null and icon != ''">#{icon},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="emailNotify != null and emailNotify != ''">#{emailNotify},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateServiceDict" parameterType="MtgServiceDict">
        update mtg_service_dict
        <set>
            <if test="serviceName != null and serviceName != ''">service_name = #{serviceName},</if>
            <if test="serviceNameEn != null">service_name_en = #{serviceNameEn},</if>
            <if test="icon != null and icon != ''">icon = #{icon},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="emailNotify != null">email_notify = #{emailNotify},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where service_id = #{serviceId}
    </update>

    <delete id="deleteServiceDictById" parameterType="Long">
        delete from mtg_service_dict where service_id = #{serviceId}
    </delete>

    <delete id="deleteServiceDictByIds" parameterType="Long">
        delete from mtg_service_dict where service_id in
        <foreach item="serviceId" collection="array" open="(" separator="," close=")">
            #{serviceId}
        </foreach>
    </delete>

</mapper>