<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mingxing.mtg.mapper.MtgRoomDeviceMapper">

    <resultMap type="MtgRoomDevice" id="MtgRoomDeviceResult">
        <id     property="id"          column="id"          />
        <result property="roomId"      column="room_id"      />
        <result property="deviceId"    column="device_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
    </resultMap>

    <sql id="selectRoomDeviceVo">
        select id, room_id, device_id, create_by, create_time
        from mtg_room_device
    </sql>

    <insert id="batchInsertRoomDevice" parameterType="java.util.List">
        insert into mtg_room_device (room_id, device_id, create_by)
        values
        <foreach item="item" collection="list" separator=",">
            (#{item.roomId}, #{item.deviceId}, #{item.createBy})
        </foreach>
    </insert>

    <delete id="deleteRoomDeviceByRoomId" parameterType="Long">
        delete from mtg_room_device where room_id = #{roomId}
    </delete>

    <delete id="deleteRoomDeviceByIds" parameterType="Long">
        delete from mtg_room_device where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectRoomDeviceList" parameterType="Long" resultMap="MtgRoomDeviceResult">
        <include refid="selectRoomDeviceVo"/>
        where room_id = #{roomId}
    </select>

</mapper>