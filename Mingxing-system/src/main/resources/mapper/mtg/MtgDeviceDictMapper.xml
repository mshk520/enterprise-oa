<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mingxing.mtg.mapper.MtgDeviceDictMapper">

    <resultMap type="MtgDeviceDict" id="MtgDeviceDictResult">
        <id     property="deviceId"      column="device_id"      />
        <result property="deviceName"    column="device_name"    />
        <result property="deviceNameEn"  column="device_name_en" />
        <result property="icon"          column="icon"           />
        <result property="sort"          column="sort"           />
        <result property="status"        column="status"         />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectDeviceDictVo">
        select device_id, device_name, device_name_en, icon, sort, status, create_by, create_time, update_by, update_time, remark
        from mtg_device_dict
    </sql>

    <select id="selectDeviceDictList" parameterType="MtgDeviceDict" resultMap="MtgDeviceDictResult">
        <include refid="selectDeviceDictVo"/>
        <where>
            <if test="deviceName != null and deviceName != ''">
                AND device_name like concat('%', #{deviceName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and date_format(create_time,'%Y%m%d') >= date_format(#{params.beginTime},'%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and date_format(create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
            </if>
        </where>
        order by sort asc, device_id asc
    </select>

    <select id="selectDeviceDictById" parameterType="Long" resultMap="MtgDeviceDictResult">
        <include refid="selectDeviceDictVo"/>
        where device_id = #{deviceId}
    </select>

    <select id="selectDeviceDictByName" parameterType="String" resultMap="MtgDeviceDictResult">
        <include refid="selectDeviceDictVo"/>
        where device_name = #{deviceName} limit 1
    </select>

    <insert id="insertDeviceDict" parameterType="MtgDeviceDict">
        insert into mtg_device_dict (
            <if test="deviceName != null and deviceName != ''">device_name,</if>
            <if test="deviceNameEn != null and deviceNameEn != ''">device_name_en,</if>
            <if test="icon != null and icon != ''">icon,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        ) values (
            <if test="deviceName != null and deviceName != ''">#{deviceName},</if>
            <if test="deviceNameEn != null and deviceNameEn != ''">#{deviceNameEn},</if>
            <if test="icon != null and icon != ''">#{icon},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateDeviceDict" parameterType="MtgDeviceDict">
        update mtg_device_dict
        <set>
            <if test="deviceName != null and deviceName != ''">device_name = #{deviceName},</if>
            <if test="deviceNameEn != null">device_name_en = #{deviceNameEn},</if>
            <if test="icon != null and icon != ''">icon = #{icon},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where device_id = #{deviceId}
    </update>

    <delete id="deleteDeviceDictById" parameterType="Long">
        delete from mtg_device_dict where device_id = #{deviceId}
    </delete>

    <delete id="deleteDeviceDictByIds" parameterType="Long">
        delete from mtg_device_dict where device_id in
        <foreach item="deviceId" collection="array" open="(" separator="," close=")">
            #{deviceId}
        </foreach>
    </delete>

    <select id="countRoomByDeviceId" parameterType="Long" resultType="int">
        select count(1) from mtg_room_device where device_id = #{deviceId}
    </select>

</mapper>